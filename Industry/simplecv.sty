% ------------------------------------------------------------
% LISTS
% ------------------------------------------------------------

\setlist[itemize]{
    leftmargin=*,
    labelsep=.4em,
    itemsep=0pt,
    parsep=0pt,
    topsep=0pt,
    partopsep=0pt
}

% ------------------------------------------------------------
% PDF
% ------------------------------------------------------------

\usepackage[
    bookmarks,
    colorlinks,
    breaklinks,
    pdftitle={Sajed Zarinpour - vita},
    pdfauthor={Sajed Zarinpour},
    pdfproducer={https://github.com/sajed-zarrinpour}
]{hyperref}

\hypersetup{
    linkcolor=blue,
    citecolor=blue,
    filecolor=black,
    urlcolor=MidnightBlue
}

% ------------------------------------------------------------
% HELPERS
% ------------------------------------------------------------

\newcommand{\seperatorcolor}{\textcolor{Cerulean}}

\newcommand{\raisedrulefill}[2][0ex]{%
    \leaders\hbox{\rule[#1]{1pt}{#2}}\hfill
}

\newcommand{\slimseperator}{%
    \seperatorcolor{\raisedrulefill[0.4ex]{.5pt}}%
}

\newcommand{\seperator}{%
    \seperatorcolor{\raisedrulefill[0.4ex]{3pt}}%
}

% ------------------------------------------------------------
% NAME AND HEADINGS
% ------------------------------------------------------------

\newcommand{\name}[1]{%
    {\fontsize{10}{12}\selectfont #1}\\[-0.1cm]
}

\newcommand{\heading}[1]{%
    {\fontsize{20}{24}\selectfont #1}\\[-0.1cm]
}

\newcommand{\headline}[1]{%
    \begin{center}
        \large #1\normalsize\normalfont\\[0.15cm]
    \end{center}
}

% ------------------------------------------------------------
% COLUMNS
% ------------------------------------------------------------

\newcommand{\aside}[2]{%
    \par\smallskip
    \noindent
    \makebox[1.55in][l]{\mbox{#1}}%
    \hspace{0.12in}%
    \begin{minipage}[t]{\dimexpr\linewidth-1.67in\relax}
        \raggedright
        #2
    \end{minipage}%
    \par\smallskip
}


\newcommand{\sectionaside}[2]{%
    \par\smallskip
    \noindent
    \begin{minipage}[t]{0.05\linewidth}
        \raggedright
        #1
    \end{minipage}%
    \hfill
    \begin{minipage}[t]{0.93\linewidth}
        \raggedright
        #2
    \end{minipage}%
}


% ------------------------------------------------------------
% CONTACT
% ------------------------------------------------------------

\newcommand{\contactInfo}[4]{%
    \begin{center}
        \small
        \textcolor{gray}{#1}
        \,|\, 
        \textcolor{gray}{#2}
        \,|\, 
        \textcolor{gray}{#3}
        % \,|\, % phone
        % \textcolor{gray}{#4}
    \end{center}
}

% ------------------------------------------------------------
% SKILLS
% ------------------------------------------------------------

\newcommand{\skills}[1]{%
    \begin{inparaitem}%
        \ForEach
        {,}
        {\item \thislevelitem\hspace{3pt}}
        {#1}%
    \end{inparaitem}%
}

\newcommand{\languagelvl}[1]{%
    \small\em\bfseries #1\normalfont
}

% ------------------------------------------------------------
% SECTIONS
% ------------------------------------------------------------

\titleformat{\section}
    {\large \color{gray}}
    {}
    {0em}
    {%
        \sectionaside{\slimseperator}{\bfseries #1\normalfont}%
    }

\titlespacing*{\section}
    {0pt}
    {0.25cm}
    {0.05cm}

% ------------------------------------------------------------
% EDUCATION
% ------------------------------------------------------------

\newcommand{\eduEntry}[5]{%
    \aside{#1}{%
         #2,\normalfont \color{gray}\small #3 \normalfont \normalcolor \\[-0.05cm]
         \it #4 %\\[-0.05cm]
        \color{gray}#5\normalcolor
    }%
}

% ------------------------------------------------------------
% CERTIFICATES
% ------------------------------------------------------------

\newcommand{\packageEntry}[3]{%
    \aside{#1}{%
        #2\\[-0.05cm]
        \normalsize\normalfont
        \color{gray}#3\normalcolor
    }%
}

% ------------------------------------------------------------
% EXPERIENCE
% ------------------------------------------------------------

\newcommand{\expEntry}[5]{%
    \aside{#1}{%
         #2,\normalfont
        \color{gray}\ #3#4\normalcolor\\[-0.05cm]
        #5
        \normalsize\normalfont
    }%
}

\newcommand{\explist}[1]{%
    {\setstretch{0.90}%
    \begin{itemize}[
        leftmargin=*,
        labelsep=.4em,
        itemsep=0pt,
        parsep=0pt,
        topsep=0pt,
        partopsep=0pt
    ]
        \ForEach
        {;}
        {\item \thislevelitem}
        {#1}
    \end{itemize}%
    }%
}

% ------------------------------------------------------------
% INTERESTS
% ------------------------------------------------------------

\newcommand{\interestslist}[1]{%
    \begin{multicols}{2}
        \begin{itemize}[
            leftmargin=*,
            labelsep=.4em,
            itemsep=0pt,
            parsep=0pt,
            topsep=0pt,
            partopsep=0pt
        ]
            \ForEach
            {,}
            {\item \thislevelitem}
            {#1}
        \end{itemize}
    \end{multicols}
}

% ------------------------------------------------------------
% CONFERENCES
% ------------------------------------------------------------

\newcommand{\confEntry}[3]{%
    \aside{#1}{%
         #2\\[-0.05cm]
        \normalfont\em\small \color{gray} #3
        \normalsize\normalfont
    }%
}

% ------------------------------------------------------------
% REFERENCES
% ------------------------------------------------------------

\newcommand{\refEntry}[5]{%
    \bfseries #2\normalfont\ -- #3 #1\\[-0.05cm]
    \indent\hspace{.2cm}
    \color{gray}Email:\normalcolor\ #4\\[-0.05cm]
    \indent\hspace{.2cm}
    \color{gray}Address:\normalcolor\ #5
    \normalsize\normalfont
}

% ------------------------------------------------------------
% TAG BOXES
% ------------------------------------------------------------

\newtcolorbox{tagbox}[1][]{%
    colback=blue!10!white,
    arc=5pt,
    auto outer arc,
    boxrule=0pt,
    enhanced jigsaw,
    nobeforeafter,
    width=2cm,
    height=.5cm,
    boxsep=0pt,
    halign=center,
    valign=center,
    box align=center,
    colupper=black,
    top=\fboxsep,
    bottom=\fboxsep,
    left=\fboxsep,
    right=\fboxsep,
    baseline=\fboxsep,
    #1
}

\newcommand{\sotagbox}[2][]{%
    \begin{tagbox}[#1]
        #2
    \end{tagbox}%
}

% ------------------------------------------------------------
% TEXT HELPERS
% ------------------------------------------------------------

\newcommand{\bold}[1]{%
    \bfseries #1\normalfont
}

\newcommand{\languageEnry}[2]{%
    #1 -- \small\em #2\normalfont
}

% ------------------------------------------------------------
% LANGUAGE SELF-ASSESSMENT
% ------------------------------------------------------------

\newcommand{\selfAssessedEng}[5]{%
    \aside{Understanding:}{%
        \skills{Listening #1, Reading #2}%
    }

    \aside{Speaking:}{%
        \skills{Spoken Interaction #3, Spoken Production #4}%
    }

    \aside{Writing:}{%
        \skills{#5}%
    }

    \small
    According to
    \href{https://europass.cedefop.europa.eu/resources/european-language-levels-cefr}
    {European language levels}:
    Basic user (A1, A2) --
    Independent user (B1, B2) --
    Proficient user (C1, C2).
    \normalfont
}
